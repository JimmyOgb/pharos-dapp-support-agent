{
  "name": "pharos-dapp-support-agent",
  "version": "1.0.0",
  "description": "Evidence-based, zero-simulation dApp Support Agent for Pharos transactions via official Chain MCP",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "node --experimental-strip-types src/build.ts",
    "bundle:api": "esbuild src/api/*.ts --bundle --platform=node --format=esm --outdir=api",
    "test": "node --dns-result-order=ipv4first --test --experimental-strip-types tests/unit/*.test.ts",
    "test:integration": "node --dns-result-order=ipv4first --test --experimental-strip-types tests/integration/*.test.ts",
    "test:all": "node --dns-result-order=ipv4first --test --experimental-strip-types tests/**/*.test.ts",
    "start": "node --dns-result-order=ipv4first --experimental-strip-types src/server.ts",
    "dev": "node --dns-result-order=ipv4first --experimental-strip-types src/server.ts"
  },
  "keywords": [
    "pharos",
    "pharos-agent-arena",
    "dapp-support",
    "chain-mcp",
    "evm",
    "forensics",
    "transaction-debugger",
    "typescript"
  ],
  "author": "JimmyOgb",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
