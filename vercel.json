{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/diagnose",
      "destination": "/api/diagnose.js"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
